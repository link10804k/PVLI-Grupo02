export default class TutorialScene{
    constructor(scene) {
        this.scene = scene;
        this.dialogues = [
            { text: "¡Hola! Bienvenido al tutorial." },
            { text: "Yo te enseñaré cómo funciona este juego." },
            { text: "Haz clic en la tile inferior derecha.", action: "CLICK_TILE_1_1" },
            { text: "¡Perfecto! Ahora vamos a construir una cafetería." },
            { text: "Cuando estés listo, pulsa el botón continuar." }
        ];

        this.currentIndex = 0;
        this.isTyping = false;
        this.fullText = '';
        this.displayedText = '';
        this.charIndex = 0;
        this.typingSpeed = 30;ç

        this.awaitingAction = null;
        
        this.createUI();
    }

    createUI() {
        //Imagen del personaje
        this.character = this.scene.add.image(150, 500, "worker")
        .setDisplaySize(120, 120)
        .setScrollFactor(0);

        //Panel de diálogo
        this.dialoguePanel = this.scene.add.rectangle(500, 500, 800, 200, 0x000000, 0.6)
        .setStrokeStyle(2, 0xffffff)
        .setScrollFactor(0);

        //Texto
        this.dialogueText = this.scene.add.text(200, 450, "", {
            fontSize: "26px",
            color: "#ffffff",
            wordWrap: { width: 650 }
        }).setScrollFactor(0);

        //Botón de avanzar
        this.nextButton = this.scene.add.text(820, 550, "Continuar", {
            fontSize: "30px",
            color: "#00d1ff",
            fontStyle: "bold"
        })
        .setInteractive()
        .setScrollFactor(0)
        .on('pointerdown', () => this.onNextPressed());
    }

    start() {
        this.showDialogue();
    }

    showDialogue(index) {
        this.currentIndex = index;

        const data = this.dialogues[index];
        this.fullText = data.text;
        this.displayText = "";
        this.dialogText.setText("");
        this.charIndex = 0;
        this.isTyping = true;

        //Si requiere una acción del jugador
        this.awaitingAction = data.action || null;

        this.typeWriterStep();
    }

    typeWriterStep() {
        if (this.isTyping) {
            this.isTyping = false;
            this.dialogueText.setText(this.fullText);
            return;
        }

        if(this.awaitingAction) return;

        this.goToNextDialogue();
    }

    goToNextDialogue() {

}